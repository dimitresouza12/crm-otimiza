{
  "name": "otimiza-crm",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "NODE_ENV=production tsc -b && NODE_ENV=production vite build && node scripts/create-static-preview.mjs",
    "preview": "vite preview",
    "api:dev": "tsx watch server/index.ts",
    "api:start": "tsx server/index.ts",
    "db:migrate": "tsx server/migrate.ts",
    "test:evolution": "node --import tsx --test server/evolution.test.ts server/message-text.test.ts",
    "test:plans": "node --import tsx --test server/pricing.test.ts",
    "test:ai": "node --import tsx --test server/lead-ai.test.ts",
    "test:bot": "node --import tsx --test server/chatbot-logic.test.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/jwt": "^10.2.2",
    "@fastify/rate-limit": "^11.2.0",
    "@vitejs/plugin-react": "^4.3.4",
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.4",
    "fastify": "^5.12.5",
    "fastify-raw-body": "^6.0.1",
    "lucide-react": "^0.468.0",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^6.1.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "tsx": "^4.23.15",
    "typescript": "~5.7.2"
  }
}
